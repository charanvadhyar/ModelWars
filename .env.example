# ─────────────────────────────────────────────────────────────────────────────
# .env.example — copy to .env and fill in all values before deploying.
# NEVER commit .env to version control.
# ─────────────────────────────────────────────────────────────────────────────

# PostgreSQL
POSTGRES_USER=modelwars
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=modelwars
DATABASE_URL=postgresql://modelwars:change-me-strong-password@localhost:5432/modelwars

# AI API Keys
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-...

# Auth — generate with: openssl rand -hex 32
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRY_DAYS=7

# Game Server
GAME_SERVER_PORT=3001
CORS_ORIGINS=http://localhost:3000

# Next.js — internal (Docker network)
GAME_SERVER_URL=http://game-server:3001

# Next.js — public (browser-facing, must be externally reachable)
NEXT_PUBLIC_GAME_SERVER_URL=http://localhost:3001
NEXT_PUBLIC_WS_URL=ws://localhost:3001

# Production overrides (uncomment):
# NODE_ENV=production
# CORS_ORIGINS=https://yourdomain.com
# NEXT_PUBLIC_GAME_SERVER_URL=https://yourdomain.com
# NEXT_PUBLIC_WS_URL=wss://yourdomain.com
